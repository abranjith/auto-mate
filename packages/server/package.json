{
  "name": "@automate/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "doctor": "tsx src/preflight/doctor-cli.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@automate/core": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@sinclair/typebox": "0.34.52",
    "busboy": "1.6.0",
    "csv-parse": "7.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/ws": "8.18.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
